[run]
source = app
omit = 
    */tests/*
    */__pycache__/*
    */venv/*
    */.venv/*

[report]
# P1 & P2 modules should have 100% coverage
precision = 2
show_missing = True
skip_covered = False

# Exclude lines from coverage (if needed)
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod

